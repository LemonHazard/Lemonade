#
# Action bindings: an action name followed by up to 4 keys or mouse buttons.
# Key names are listed in src/input.h (case doesn't matter).
#

#---------------------------------------
# Controls
#---------------------------------------

MoveForward         W UpArrow
MoveBackward        S DownArrow
MoveLeft            A LeftArrow
MoveRight           D RightArrow
Jump                Space MouseRight

#---------------------------------------
# UI
#---------------------------------------

Quit                Escape
# The engine's: saves the frame to screenshots/<date>_<time>.png
Screenshot          F12
